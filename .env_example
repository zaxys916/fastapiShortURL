# ============================
# 环境变量模板 —— 复制为 .env 后填写真实值
# .env 已被 .gitignore 忽略，切勿提交到仓库
# ============================

# 应用名称 / 版本
APP_NAME=fastapishorturl
APP_VERSION=1.0.0

# 数据库连接串（本项目为 SQLite 异步驱动）
# 生产环境可替换为 PostgreSQL，如：
# postgresql+asyncpg://user:pass@host:5432/shorturl
ASYNC_DATABASE_URL=sqlite+aiosqlite:///short.db

# JWT 签名密钥（部署时必须更换为随机强密钥，例如以下命令生成）
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

# JWT 签名算法
JWT_ALGORITHM=HS256